# Vercel Postgres / Neon pooled connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Both organizer magic links and drills are console-only stubs until an ESP is chosen.
# No Resend or SMTP key is used by this MVP.
MAIL_ADAPTER=console

