# Vercel Postgres / Neon pooled connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Hosted defaults. Replace both with your own origin when self-hosting.
AUTH_URL=https://app.familydrill.com
APP_URL=https://app.familydrill.com

# Use `resend` for production drill delivery; any other value keeps the console stub.
MAIL_ADAPTER=console
RESEND_API_KEY=
EMAIL_FROM=Family Drill <drills@familydrill.com>
